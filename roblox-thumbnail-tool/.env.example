# =============================================================================
# ROBLOX THUMBNAIL DATASET TOOL — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_PORT=3001
APP_HOST=0.0.0.0
APP_LOG_LEVEL=info
# Unique secret for internal API auth (generate: openssl rand -base64 32)
APP_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_32
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
# Development: SQLite (no config needed — auto-created at DATA_DIR/roblox.db)
# Production: Uncomment and set PostgreSQL via Supabase free tier
DATABASE_URL=file:./data/roblox.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/roblox_thumbnails?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# For cloud Redis (Upstash free tier):
# REDIS_URL=redis://default:PASSWORD@HOST:PORT

# --- Storage ---
# Provider: 'local' | 'supabase' | 'cloudinary'
STORAGE_PROVIDER=local
DATA_DIR=./data
IMAGES_DIR=./data/images

# Supabase Storage (free: 1 GB storage, 500 MB DB)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=thumbnails

# Cloudinary (free: 25 GB storage, 25 GB bandwidth)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Roblox API ---
# No auth required. Settings below control rate limiting.
ROBLOX_API_BASE_URL=https://thumbnails.roblox.com
ROBLOX_GAMES_API_URL=https://games.roblox.com
ROBLOX_USERS_API_URL=https://users.roblox.com
# Safe rate: ~100 req/min. minTime = ms between requests (100 = 10 req/sec)
ROBLOX_RATE_LIMIT_MIN_TIME=100
ROBLOX_RATE_LIMIT_MAX_CONCURRENT=5
ROBLOX_CACHE_TTL_SECONDS=3600

# --- Fallback Search APIs (optional) ---
# Bing Image Search (1,000 calls/month free)
BING_API_KEY=

# DuckDuckGo (no key required, limited image capability)
DUCKDUCKGO_ENABLED=true

# --- Queue / BullMQ ---
QUEUE_CONCURRENCY=10
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_REMOVE_ON_COMPLETE=50
DLQ_NAME=thumbnail-dlq

# --- Image Processing ---
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100
PHASH_SIMILARITY_THRESHOLD=90
DEFAULT_OUTPUT_FORMAT=png
DEFAULT_OUTPUT_QUALITY=85
ENABLE_DEDUPLICATION=true
ENABLE_METADATA_EXTRACTION=true

# --- Observability ---
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
OPENTELEMETRY_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318

# --- CI/CD (set in GitHub Actions secrets — do NOT put real values here) ---
# DOCKER_USERNAME=
# DOCKER_PASSWORD=
# DEPLOY_SSH_KEY=
